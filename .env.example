# Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5
# Okghumo MCP server: READ-ONLY. Health: https://mcp.okghumo.com/health
OKGHUMO_MCP_URL=https://mcp.okghumo.com/mcp
# Per-vendor OkGhumo credentials are stored encrypted in the app DB (PUT /credentials), exchanged for a
# 15-min MCP token per vendor. There is NO shared login token any more.
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_KEY=
# sqlite file (credentials, scheduled reminders, inbox); docker-compose sets /data/app.db
DB_PATH=data/app.db
# scheduler process kill switch (1 = fire reminders and reports)
SCHEDULER_ENABLED=1
# chat can propose/confirm schedules (0 = off, also ignores pending confirmations)
SCHEDULING_VIA_CHAT=1
# cheaper model for scheduled reports (defaults to CHAT_MODEL)
# REPORT_MODEL=
# OKGHUMO_AUTH_URL=https://prod.okghumo.com
# Verifies caller JWTs (HS256); token must carry "sub" (vendor id) and "role" claims
JWT_SECRET=change-me
# Browser UI origin(s) allowed to call /chat, comma-separated (e.g. https://chat.okghumo.com)
CORS_ORIGINS=

# --- WhatsApp bot (webhook: https://<domain>/whatsapp/webhook; Meta requires HTTPS) ---
WHATSAPP_PHONE_NUMBER_ID=      # Meta app > WhatsApp > API Setup
WHATSAPP_TOKEN=                # permanent system-user token (whatsapp_business_messaging)
WHATSAPP_APP_SECRET=           # Meta app > Settings > Basic; verifies webhook signatures
WHATSAPP_VERIFY_TOKEN=         # any long random string; you type the same one into Meta's webhook config
WHATSAPP_LINK_SECRET=          # shared with OkGhumo; sent as X-Whatsapp-Link-Secret, never in a message/link/log
# WHATSAPP_API_VERSION=v23.0   # Graph API version; confirm a currently supported one in the Meta dashboard
# Scheduled reports outside WhatsApp's 24h window need an approved utility template with ONE text variable ({{1}} = report name),
# e.g. "Your {{1}} is ready. Reply with any message to read it." Unset = reports wait until the vendor next writes.
# WHATSAPP_REPORT_TEMPLATE=
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_TEMPLATE_PARAM=report_type   # only if the template uses a NAMED variable ({{report_type}}) instead of {{1}}

# --- WhatsApp voice notes (speech-to-text; vendor audio is sent to the provider, kept in memory only) ---
# Voice is ON only when STT_API_KEY is set. Without it the bot replies "I can only read text messages".
STT_API_KEY=                   # OpenAI API key (platform.openai.com), used only for transcription
# STT_MODEL=whisper-1
# VOICE_ENABLED=1              # 0 = kill switch
# VOICE_MAX_SECONDS=150        # longer notes are refused before any transcription cost
# VOICE_MAX_BYTES=5000000
# RATE_WA_VOICE_PER_HOUR=10    # per phone; typed-message limits (RATE_WA_PER_MIN/HOUR) still apply to the transcript
